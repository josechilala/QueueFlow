# Optional local overrides. Compose has development-only defaults, so
# `docker compose up` works without this file. Never commit a real `.env`.
POSTGRES_PASSWORD=replace-with-a-long-random-secret
AUTHENTICATION_JWT_KEY=replace-with-at-least-32-random-characters
PRIVACY__APPOINTMENTPIIRETENTIONDAYS=365
# Required only for local invitation verification; supply a random secret here.
ONBOARDING_VERIFICATION_CODE_PEPPER=
