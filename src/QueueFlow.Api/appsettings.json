{
  "ConnectionStrings": {
    "QueueFlowDatabase": "Host=localhost;Port=5432;Database=queueflow;Username=queueflow"
  },
  "Authentication": {
    "Issuer": "QueueFlow",
    "Audience": "QueueFlow.Web"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "UseBackplane": false
  },
  "Onboarding": {
    "AllowPublicRegistration": false,
    "InvitationExpirationHours": 24,
    "VerificationCodeExpirationMinutes": 10,
    "VerificationCodeCooldownSeconds": 60,
    "VerificationCodeMaxAttempts": 5,
    "ExposeVerificationCodeForDevelopment": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jobs": {
    "ExpiredTicketHours": 8
  },
  "Privacy": {
    "TicketPiiRetentionDays": 90,
    "AppointmentPiiRetentionDays": 365,
    "AuditRetentionDays": 1825
  },
  "AllowedHosts": "*"
}
