# Copy to .env.staging. This file is intentionally safe to commit; never put real secrets here.
STAGING_POSTGRES_PASSWORD=replace-with-a-long-random-staging-secret
STAGING_AUTHENTICATION_JWT_KEY=replace-with-at-least-32-random-staging-characters
# Invitation verification also requires a real email adapter in Staging.
STAGING_ONBOARDING_VERIFICATION_CODE_PEPPER=

# Loopback defaults support local staging validation. Use HTTPS public URLs in shared staging.
STAGING_API_PUBLIC_URL=http://localhost:18080
STAGING_ADMIN_ORIGIN=http://localhost:13000
STAGING_CUSTOMER_ORIGIN=http://localhost:13001
STAGING_DISPLAY_ORIGIN=http://localhost:13002
STAGING_ATTENDANT_ORIGIN=http://localhost:13003
STAGING_SECURE_COOKIES=false

STAGING_API_PORT=18080
STAGING_ADMIN_PORT=13000
STAGING_CUSTOMER_PORT=13001
STAGING_DISPLAY_PORT=13002
STAGING_ATTENDANT_PORT=13003
STAGING_PROMETHEUS_PORT=19090
STAGING_ALERTMANAGER_PORT=19093
STAGING_OTLP_GRPC_PORT=14317
STAGING_OTLP_HTTP_PORT=14318
